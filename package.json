{
  "name": "puki-core",
  "version": "1.0.0",
  "description": "A small discord.js v14 bot framework: file-based command, event and component loaders, PostgreSQL through Sequelize, cooldowns and permission checks.",
  "main": "src/index.js",
  "scripts": {
    "start": "node .",
    "backup": "node scripts/backup.js",
    "start:sharded": "node src/shard.js",
    "test": "node scripts/test.js",
    "lint": "eslint src tests scripts"
  },
  "keywords": [
    "discord",
    "discord.js",
    "discord-bot",
    "bot-framework",
    "sequelize",
    "postgresql"
  ],
  "author": "Grawty",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grawty/puki-core.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "discord.js": "^14.15.2",
    "dotenv": "^18.0.9",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "eslint": "^9.39.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
