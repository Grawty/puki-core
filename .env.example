# Copy to .env and fill it in. Never commit .env.

# Discord application: https://discord.com/developers/applications
CLIENT_TOKEN=
CLIENT_ID=

# Set this while developing: commands are registered on this server only and show up instantly.
# Leave empty to register them globally.
GUILD_ID=

# Text command prefix. Needs the Message Content intent enabled in the developer portal.
PREFIX=!

# Shown under the bot's name as "Watching ..."
STATUS_TEXT=/help

# Comma separated user ids allowed to run owner-only commands
OWNER_ID=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=puki_core
DB_USER=postgres
DB_PASSWORD=
